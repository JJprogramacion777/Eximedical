# Copia este archivo como .env y completa los valores

# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:TU_CONTRASEÑA@localhost:5433/eximedical

# Clave para firmar la cookie de sesión del panel (mínimo 32 caracteres aleatorios).
# Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Carpeta donde se guardan las imágenes y PDFs subidos desde el panel (opcional)
# UPLOADS_DIR=./storage/uploads
